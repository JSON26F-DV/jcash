<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="privacyRoot" prefHeight="700" prefWidth="1280" style="-fx-background-color:#F4F6F9; -fx-font-family:'Inter';" stylesheets="@../../css/Style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.controller.common.PolicyPageController">
   <top>
      <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-background-color:#FFFFFF; -fx-border-color:transparent transparent #EEF1F6 transparent;">
         <padding><Insets bottom="20" left="48" right="48" top="20" /></padding>
         <Button onAction="#returnToLanding" styleClass="policy-back-button" text="%common.back" />
         <Label style="-fx-font-family:'Plus Jakarta Sans'; -fx-font-size:18px; -fx-font-weight:bold; -fx-text-fill:#3454E1;" text="JCash Bank" />
         <Region HBox.hgrow="ALWAYS" />
         <Label fx:id="privacyUpdatedLabel" style="-fx-font-size:12px; -fx-text-fill:#9DA3A9;" text="%policy.updated" />
      </HBox>
   </top>
   <center>
      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color:transparent; -fx-background:transparent;">
         <content>
            <VBox alignment="TOP_CENTER" spacing="24" style="-fx-background-color:transparent;">
               <padding><Insets bottom="48" left="28" right="28" top="40" /></padding>
               <VBox maxWidth="840" spacing="24" style="-fx-background-color:#FFFFFF; -fx-background-radius:26; -fx-border-color:#EEF1F6; -fx-border-radius:26; -fx-effect:dropshadow(gaussian,rgba(30,40,80,0.08),20,0,0,8);">
                  <padding><Insets bottom="40" left="48" right="48" top="40" /></padding>
                  <VBox spacing="8">
                     <Label fx:id="privacyTitleLabel" style="-fx-font-family:'Plus Jakarta Sans'; -fx-font-size:30px; -fx-font-weight:bold; -fx-text-fill:#333948;" text="%privacy.title" wrapText="true" />
                     <Label style="-fx-font-size:14px; -fx-text-fill:#67707F;" text="%privacy.subtitle" wrapText="true" />
                  </VBox>
                  <VBox spacing="18">
                     <VBox spacing="6"><Label style="-fx-font-size:16px; -fx-font-weight:bold; -fx-text-fill:#333948;" text="%privacy.s1.title" /><Label style="-fx-font-size:13px; -fx-text-fill:#67707F; -fx-line-spacing:4px;" text="%privacy.s1.body" wrapText="true" /></VBox>
                     <VBox spacing="6"><Label style="-fx-font-size:16px; -fx-font-weight:bold; -fx-text-fill:#333948;" text="%privacy.s2.title" /><Label style="-fx-font-size:13px; -fx-text-fill:#67707F; -fx-line-spacing:4px;" text="%privacy.s2.body" wrapText="true" /></VBox>
                     <VBox spacing="6"><Label style="-fx-font-size:16px; -fx-font-weight:bold; -fx-text-fill:#333948;" text="%privacy.s3.title" /><Label style="-fx-font-size:13px; -fx-text-fill:#67707F; -fx-line-spacing:4px;" text="%privacy.s3.body" wrapText="true" /></VBox>
                     <VBox spacing="6"><Label style="-fx-font-size:16px; -fx-font-weight:bold; -fx-text-fill:#333948;" text="%privacy.s4.title" /><Label style="-fx-font-size:13px; -fx-text-fill:#67707F; -fx-line-spacing:4px;" text="%privacy.s4.body" wrapText="true" /></VBox>
                     <VBox spacing="6"><Label style="-fx-font-size:16px; -fx-font-weight:bold; -fx-text-fill:#333948;" text="%privacy.s5.title" /><Label style="-fx-font-size:13px; -fx-text-fill:#67707F; -fx-line-spacing:4px;" text="%privacy.s5.body" wrapText="true" /></VBox>
                  </VBox>
                  <Label fx:id="privacyDisclaimerLabel" style="-fx-background-color:#F7F9FC; -fx-background-radius:14; -fx-padding:14; -fx-font-size:11px; -fx-text-fill:#9DA3A9;" text="%privacy.disclaimer" wrapText="true" />
               </VBox>
            </VBox>
         </content>
      </ScrollPane>
   </center>
</BorderPane>
