<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane fx:id="deletedAccountRoot" prefHeight="700" prefWidth="1280" style="-fx-background-color:#F4F6F9; -fx-font-family:'Inter';" stylesheets="@../../css/Style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
   <top>
      <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-background-color:#FFFFFF; -fx-border-color:transparent transparent #EEF1F6 transparent;">
         <padding><Insets bottom="20" left="48" right="48" top="20" /></padding>
         <Label style="-fx-font-family:'Plus Jakarta Sans'; -fx-font-size:18px; -fx-font-weight:bold; -fx-text-fill:#3454E1;" text="JCash Bank" />
         <Region HBox.hgrow="ALWAYS" />
         <Label style="-fx-font-size:12px; -fx-text-fill:#9DA3A9;" text="%deletedAccount.access" />
      </HBox>
   </top>

   <center>
      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color:transparent; -fx-background:transparent;">
         <content>
            <VBox alignment="TOP_CENTER" style="-fx-background-color:transparent;">
               <padding><Insets bottom="48" left="28" right="28" top="40" /></padding>

               <VBox maxWidth="720" spacing="24" style="-fx-background-color:#FFFFFF; -fx-background-radius:26; -fx-border-color:#EEF1F6; -fx-border-radius:26; -fx-effect:dropshadow(gaussian,rgba(30,40,80,0.08),20,0,0,8);">
                  <padding><Insets bottom="40" left="48" right="48" top="40" /></padding>

                  <!-- Heading -->
                  <VBox alignment="CENTER" spacing="14">
                     <StackPane minHeight="56" minWidth="56">
                        <Circle fill="#FFEFF3" radius="28" />
                        <Label style="-fx-font-family:'Plus Jakarta Sans'; -fx-font-size:24px; -fx-font-weight:bold; -fx-text-fill:#E2557A;" text="!" />
                     </StackPane>
                     <Label style="-fx-font-family:'Plus Jakarta Sans'; -fx-font-size:26px; -fx-font-weight:bold; -fx-text-fill:#333948;" text="%deletedAccount.title" wrapText="true" />
                     <Label style="-fx-font-size:13px; -fx-text-fill:#67707F;" text="%deletedAccount.subtitle" wrapText="true" />
                  </VBox>

                  <!-- Reasons -->
                  <VBox spacing="10">
                     <Label style="-fx-font-size:11px; -fx-font-weight:bold; -fx-text-fill:#9DA3A9;" text="%deletedAccount.reasons.title" />

                     <VBox spacing="4" style="-fx-background-color:#F7F9FC; -fx-background-radius:14; -fx-padding:14 16 14 16;">
                        <Label style="-fx-font-size:13px; -fx-font-weight:bold; -fx-text-fill:#333948;" text="%deletedAccount.deleted.title" />
                        <Label style="-fx-font-size:12px; -fx-text-fill:#67707F;" text="%deletedAccount.deleted.body" wrapText="true" />
                     </VBox>

                     <VBox spacing="4" style="-fx-background-color:#F7F9FC; -fx-background-radius:14; -fx-padding:14 16 14 16;">
                        <Label style="-fx-font-size:13px; -fx-font-weight:bold; -fx-text-fill:#333948;" text="%deletedAccount.banned.title" />
                        <Label style="-fx-font-size:12px; -fx-text-fill:#67707F;" text="%deletedAccount.banned.body" wrapText="true" />
                     </VBox>

                     <VBox spacing="4" style="-fx-background-color:#F7F9FC; -fx-background-radius:14; -fx-padding:14 16 14 16;">
                        <Label style="-fx-font-size:13px; -fx-font-weight:bold; -fx-text-fill:#333948;" text="%deletedAccount.review.title" />
                        <Label style="-fx-font-size:12px; -fx-text-fill:#67707F;" text="%deletedAccount.review.body" wrapText="true" />
                     </VBox>
                  </VBox>

                  <!-- Support -->
                  <VBox spacing="10" style="-fx-background-color:#EEF1FE; -fx-background-radius:16; -fx-padding:18 20 18 20;">
                     <Label style="-fx-font-family:'Plus Jakarta Sans'; -fx-font-size:15px; -fx-font-weight:bold; -fx-text-fill:#3454E1;" text="%deletedAccount.help.title" />
                     <Label style="-fx-font-size:12px; -fx-text-fill:#333948;" text="%deletedAccount.help.body" wrapText="true" />
                     <Label style="-fx-font-size:12px; -fx-text-fill:#67707F;" text="%deletedAccount.help.id" wrapText="true" />
                     <Label style="-fx-font-size:11px; -fx-text-fill:#9DA3A9;" text="%deletedAccount.help.hours" wrapText="true" />
                  </VBox>

                  <Label style="-fx-font-size:11px; -fx-text-fill:#9DA3A9;" text="%deletedAccount.help.security" wrapText="true" />
               </VBox>
            </VBox>
         </content>
      </ScrollPane>
   </center>
</BorderPane>
