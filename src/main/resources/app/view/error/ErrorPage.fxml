<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="errorPageRoot" prefHeight="700" prefWidth="1280" style="-fx-background-color:#F4F6F9; -fx-font-family:'Inter';" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
   <VBox alignment="CENTER" maxWidth="560" spacing="18" style="-fx-background-color:#FFFFFF; -fx-background-radius:28; -fx-border-color:#EEF1F6; -fx-border-radius:28; -fx-effect:dropshadow(gaussian,rgba(30,40,80,0.10),24,0,0,12);">
      <padding><Insets bottom="44" left="48" right="48" top="44" /></padding>
      <StackPane minHeight="88" minWidth="88" style="-fx-background-color:#FFEFF3; -fx-background-radius:999;">
         <Label style="-fx-font-size:38px; -fx-font-weight:bold; -fx-text-fill:#E2557A;" text="!" />
      </StackPane>
      <Label fx:id="errorCodeLabel" style="-fx-font-family:'Plus Jakarta Sans'; -fx-font-size:14px; -fx-font-weight:bold; -fx-text-fill:#E2557A;" text="ERROR 404" />
      <Label fx:id="errorTitleLabel" style="-fx-font-family:'Plus Jakarta Sans'; -fx-font-size:28px; -fx-font-weight:bold; -fx-text-fill:#333948;" text="Page not found" textAlignment="CENTER" wrapText="true" />
      <Label fx:id="errorMessageLabel" maxWidth="440" style="-fx-font-size:14px; -fx-text-fill:#67707F; -fx-line-spacing:4px;" text="The page you’re looking for may have been moved, removed, or is temporarily unavailable." textAlignment="CENTER" wrapText="true" />
      <Region minHeight="4" />
      <HBox alignment="CENTER" spacing="12">
         <Button fx:id="backButton" mnemonicParsing="false" prefHeight="44" style="-fx-background-color:#FFFFFF; -fx-background-radius:16; -fx-border-color:#EEF1F6; -fx-border-radius:16; -fx-text-fill:#333948; -fx-font-size:13px; -fx-font-weight:bold; -fx-padding:0 20 0 20;" text="Go back" />
         <Button fx:id="homeButton" mnemonicParsing="false" prefHeight="44" style="-fx-background-color:#3454E1; -fx-background-radius:16; -fx-text-fill:#FFFFFF; -fx-font-size:13px; -fx-font-weight:bold; -fx-padding:0 20 0 20;" text="Back to home" />
      </HBox>
   </VBox>
</StackPane>
