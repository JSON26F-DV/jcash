<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>

<VBox fx:id="sidebar" maxWidth="214" minWidth="72" prefWidth="214" spacing="6" style="-fx-background-color:#FFFFFF; -fx-background-radius:32 0 0 32; -fx-border-color:transparent #F0F2F6 transparent transparent;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.controller.components.SidebarController">
   <padding><Insets bottom="24" left="14" right="14" top="24" /></padding>

   <!-- Header -->
   <HBox fx:id="sidebarHeaderBox" alignment="CENTER_LEFT" spacing="10">
      <padding><Insets bottom="14" left="14" /></padding>
      <Label fx:id="bankNameLabel" style="-fx-font-family:'Plus Jakarta Sans','Noto Sans CJK JP','Noto Sans CJK KR','Noto Sans CJK SC',sans-serif; -fx-font-size:13px; -fx-font-weight:bold; -fx-text-fill:#333948;" text="Jcash Bank" />
   </HBox>

   <!-- Navigation Menu Items -->
   <Button fx:id="navDashboardButton" alignment="CENTER_LEFT" graphicTextGap="12" maxWidth="Infinity" prefHeight="44" style="-fx-background-color:#EEF1FE; -fx-background-radius:16; -fx-text-fill:#3454E1; -fx-font-size:13px; -fx-font-weight:bold; -fx-padding:0 0 0 14; -fx-cursor:hand;" text="%sidebar.dashboard">
      <graphic>
         <SVGPath content="M3 3h8v8H3V3zm10 0h8v8h-8V3zM3 13h8v8H3v-8zm10 0h8v8h-8v-8z" fill="#3454E1" scaleX="0.8" scaleY="0.8" />
      </graphic>
      <tooltip><Tooltip text="%sidebar.dashboard" /></tooltip>
   </Button>

   <Button fx:id="navCashInButton" alignment="CENTER_LEFT" graphicTextGap="12" maxWidth="Infinity" prefHeight="44" style="-fx-background-color:transparent; -fx-background-radius:16; -fx-text-fill:#9DA3A9; -fx-font-size:13px; -fx-padding:0 0 0 14; -fx-cursor:hand;" text="%sidebar.accounts">
      <graphic>
         <SVGPath content="M21 18v1c0 1.1-.9 2-2 2H5c-1.11 0-2-.9-2-2V5c0-1.1.89-2 2-2h14c1.1 0 2 .9 2 2v1h-9c-1.11 0-2 .9-2 2v8c0 1.1.89 2 2 2h9zm-9-2h10V8H12v8zm4-2.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z" fill="#9DA3A9" scaleX="0.8" scaleY="0.8" />
      </graphic>
      <tooltip><Tooltip text="%sidebar.accounts" /></tooltip>
   </Button>

   <Button fx:id="navCardsButton" alignment="CENTER_LEFT" graphicTextGap="12" maxWidth="Infinity" prefHeight="44" style="-fx-background-color:transparent; -fx-background-radius:16; -fx-text-fill:#9DA3A9; -fx-font-size:13px; -fx-padding:0 0 0 14; -fx-cursor:hand;" text="%sidebar.cards">
      <graphic>
         <SVGPath content="M20 4H4c-1.11 0-1.99.89-1.99 2L2 18c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V6c0-1.11-.89-2-2-2zm0 14H4v-6h16v6zm0-10H4V6h16v2z" fill="#9DA3A9" scaleX="0.8" scaleY="0.8" />
      </graphic>
      <tooltip><Tooltip text="%sidebar.cards" /></tooltip>
   </Button>

   <Button fx:id="navExpressSendButton" alignment="CENTER_LEFT" graphicTextGap="12" maxWidth="Infinity" prefHeight="44" style="-fx-background-color:transparent; -fx-background-radius:16; -fx-text-fill:#9DA3A9; -fx-font-size:13px; -fx-padding:0 0 0 14; -fx-cursor:hand;" text="%sidebar.newTransaction">
      <graphic>
         <SVGPath content="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" fill="#9DA3A9" scaleX="0.8" scaleY="0.8" />
      </graphic>
      <tooltip><Tooltip text="%sidebar.newTransaction" /></tooltip>
   </Button>

   <Button fx:id="navTransactionsButton" alignment="CENTER_LEFT" graphicTextGap="12" maxWidth="Infinity" prefHeight="44" style="-fx-background-color:transparent; -fx-background-radius:16; -fx-text-fill:#9DA3A9; -fx-font-size:13px; -fx-padding:0 0 0 14; -fx-cursor:hand;" text="%sidebar.transactions">
      <graphic>
         <SVGPath content="M18 17H6v-2h12v2zm0-4H6v-2h12v2zm0-4H6V7h12v2zM3 22l1.5-1.5L6 22l1.5-1.5L9 22l1.5-1.5L12 22l1.5-1.5L15 22l1.5-1.5L18 22l1.5-1.5L21 22V2l-1.5 1.5L18 2l-1.5 1.5L15 2l-1.5 1.5L12 2l-1.5 1.5L9 2 7.5 3.5 6 2 4.5 3.5 3 2v20z" fill="#9DA3A9" scaleX="0.8" scaleY="0.8" />
      </graphic>
      <tooltip><Tooltip text="%sidebar.transactions" /></tooltip>
   </Button>

   <Button fx:id="navSettingsButton" alignment="CENTER_LEFT" graphicTextGap="12" maxWidth="Infinity" prefHeight="44" style="-fx-background-color:transparent; -fx-background-radius:16; -fx-text-fill:#9DA3A9; -fx-font-size:13px; -fx-padding:0 0 0 14; -fx-cursor:hand;" text="%sidebar.settings">
      <graphic>
         <SVGPath content="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z" fill="#9DA3A9" scaleX="0.8" scaleY="0.8" />
      </graphic>
      <tooltip><Tooltip text="%sidebar.settings" /></tooltip>
   </Button>

   <Region VBox.vgrow="ALWAYS" />

   <!-- User Profile Chip -->
   <HBox fx:id="userChip" alignment="CENTER_LEFT" spacing="10">
      <StackPane fx:id="userAvatarPane" minHeight="40" minWidth="40">
         <Circle fill="#3454E1" radius="20" />
         <Label fx:id="userInitialsLabel" style="-fx-text-fill:white; -fx-font-size:12px; -fx-font-weight:bold;" text="JC" />
      </StackPane>
      <VBox fx:id="userInfoBox" spacing="2">
         <Label fx:id="userNameLabel" style="-fx-font-size:12px; -fx-font-weight:bold; -fx-text-fill:#333948;" text="Jane Cooper" />
         <Label fx:id="userRoleLabel" style="-fx-font-size:10px; -fx-text-fill:#9DA3A9;" text="%sidebar.role.customer" />
      </VBox>
   </HBox>
</VBox>
