<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<StackPane minHeight="700" minWidth="1280" style="-fx-background-color:#F4F6F9; -fx-font-family:'Inter';" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.controller.transaction.ExpressSendController">
   <padding><Insets bottom="12" left="12" right="12" top="12" /></padding>
   <BorderPane style="-fx-background-color:#FFFFFF; -fx-background-radius:32;">
      <left><fx:include source="../components/Sidebar.fxml" /></left>
      <center>
         <VBox spacing="24">
            <HBox alignment="CENTER_LEFT" spacing="12">
               <padding><Insets left="36" right="36" top="32" /></padding>
               <Label style="-fx-font-size:14px; -fx-text-fill:#9DA3A9;" text="Express Send" />
               <Label style="-fx-text-fill:#DDE2EA;" text="|" />
               <Label fx:id="welcomeLabel" style="-fx-font-size:19px; -fx-font-weight:bold; -fx-text-fill:#333948;" />
               <Region HBox.hgrow="ALWAYS" />
               <Label fx:id="dateTimeLabel" style="-fx-font-size:11px; -fx-text-fill:#9DA3A9;" />
            </HBox>
            <VBox alignment="TOP_CENTER" spacing="24" VBox.vgrow="ALWAYS">
               <padding><Insets bottom="24" left="20" right="20" top="24" /></padding>
               <VBox maxWidth="560" spacing="24">
                  <HBox alignment="CENTER_LEFT" spacing="12">
                     <Button fx:id="backButton" prefHeight="36" prefWidth="36" style="-fx-background-color:#F7F9FC; -fx-background-radius:999; -fx-cursor:hand;">
                        <graphic><SVGPath content="M20 11H7.83l4.88-4.88c.39-.39.39-1.03 0-1.42-.39-.39-1.02-.39-1.41 0l-6.59 6.59c-.39.39-.39 1.02 0 1.41l6.59 6.59c.39.39 1.02.39 1.41 0 .39-.39.39-1.02 0-1.41L7.83 13H20c.55 0 1-.45 1-1s-.45-1-1-1z" fill="#333948" /></graphic>
                     </Button>
                     <VBox spacing="2">
                        <Label style="-fx-font-size:19px; -fx-font-weight:bold; -fx-text-fill:#333948;" text="Express Send" />
                        <Label style="-fx-font-size:12px; -fx-text-fill:#9DA3A9;" text="Send money instantly to another account." />
                     </VBox>
                  </HBox>
                  <Label fx:id="errorLabel" wrapText="true" style="-fx-font-size:13px; -fx-font-weight:bold; -fx-text-fill:#E2557A;" />
                  <VBox spacing="10">
                     <Label style="-fx-font-size:15px; -fx-font-weight:bold; -fx-text-fill:#5B6678;" text="Send to" />
                     <TextField fx:id="mobileNumberField" minHeight="62" promptText="Enter mobile number (e.g. 09171234567)" style="-fx-background-color:#FFFFFF; -fx-background-radius:10; -fx-border-color:#C9CED6; -fx-border-width:1.5; -fx-border-radius:10; -fx-font-size:19px; -fx-padding:0 18 0 18;" />
                  </VBox>
                  <VBox spacing="10">
                     <Label style="-fx-font-size:15px; -fx-font-weight:bold; -fx-text-fill:#5B6678;" text="Amount" />
                     <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-background-color:#FFFFFF; -fx-background-radius:10; -fx-border-color:#C9CED6; -fx-border-width:1.5; -fx-border-radius:10;">
                        <padding><Insets left="18" right="18" /></padding>
                        <Label style="-fx-font-size:19px; -fx-font-weight:bold; -fx-text-fill:#0B1F4B;" text="₱" />
                        <TextField fx:id="amountField" minHeight="62" promptText="0.00" style="-fx-background-color:transparent; -fx-font-size:19px; -fx-border-color:transparent;" HBox.hgrow="ALWAYS" />
                     </HBox>
                     <Label fx:id="balanceLabel" style="-fx-font-size:13px; -fx-text-fill:#0B1F4B;" />
                  </VBox>
                  <VBox spacing="10">
                     <Label style="-fx-font-size:15px; -fx-font-weight:bold; -fx-text-fill:#5B6678;" text="Message" />
                     <TextField fx:id="messageField" minHeight="62" promptText="Optional" style="-fx-background-color:#FFFFFF; -fx-background-radius:10; -fx-border-color:#C9CED6; -fx-border-width:1.5; -fx-border-radius:10; -fx-font-size:19px; -fx-padding:0 18 0 18;" />
                  </VBox>
               </VBox>
            </VBox>
            <HBox alignment="CENTER" style="-fx-background-color:#F7F8FA; -fx-background-radius:0 0 32 0;">
               <padding><Insets bottom="22" left="20" right="20" top="16" /></padding>
               <Button fx:id="nextButton" maxWidth="560" minHeight="56" prefHeight="56" prefWidth="560" style="-fx-background-color:#0A5BE0; -fx-background-radius:999; -fx-text-fill:white; -fx-font-size:19px; -fx-font-weight:bold;" text="Next" />
            </HBox>
         </VBox>
      </center>
   </BorderPane>
</StackPane>